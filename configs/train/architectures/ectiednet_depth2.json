{
  "mode": "train",
  "seed": 1,
  "dataset": "imagenet",
  "batchsize": 64,
  "num_workers": 8,
  "data_augment": false,
  "train_fraction": 1.0,

  "model_name": "ECTiedNet",
  "pretrained_dataset": "none",
  "arch": {
    "channels": 64,
    "num_iterations": 2,
    "expansion": 4,
    "max_gn_groups": 16
  },

  "optimizer": "adamw",
  "learning_rate": 1e-3,
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "lr_scheduler": "cosineannealinglr",
  "num_epochs": 90,
  "warmup_epochs": 5,

  "log_interval": 1,
  "log_checkpoints": true,
  "checkpoint_interval": 10,
  "checkpoint_dir": "ectiednet_imagenet1k_depth2",

  "use_wandb": false
}
