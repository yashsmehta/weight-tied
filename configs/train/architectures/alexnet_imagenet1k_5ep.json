{
  "mode": "train",
  "seed": 1,
  "dataset": "imagenet",
  "batchsize": 64,
  "num_workers": 8,
  "data_augment": true,
  "train_fraction": 1.0,

  "model_name": "AlexNet",
  "pretrained_dataset": "none",

  "optimizer": "adamw",
  "learning_rate": 1e-3,
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "lr_scheduler": "cosineannealinglr",
  "num_epochs": 5,
  "warmup_epochs": 1,

  "log_interval": 1,
  "log_checkpoints": true,
  "checkpoint_interval": 1,
  "checkpoint_dir": "alexnet_imagenet1k_5ep_sanity",

  "use_wandb": false
}
